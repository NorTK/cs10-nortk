<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="8.0" name="NorTK-OS">
	<description type="system">
		<author>Rénich Bon Ćirić</author>
		<contact>renich@nortk.com</contact>
		<specification>NorTK OS (CentOS Stream 10)</specification>
	</description>

	<profiles>
		<profile name="Live" description="Live image of CentOS 10"/>
		<profile name="Disk" description="OEM image of CentOS 10"/>
	</profiles>

	<preferences>
		<bootsplash-theme>nortk</bootsplash-theme>
		<bootloader-theme>nortk</bootloader-theme>
		<keytable>es</keytable>
		<locale>en_US</locale>
		<packagemanager>dnf4</packagemanager>
		<rpm-check-signatures>true</rpm-check-signatures>
		<rpm-excludedocs>true</rpm-excludedocs>
		<timezone>UTC</timezone>
		<version>0.1.0</version>
		<release-version>10</release-version>
	</preferences>

	<preferences profiles="Live">
		<type image="iso" volid="NorTKOS" flags="overlay" firmware="efi" hybridpersistent_filesystem="ext4" hybridpersistent="true" selinux_policy="targeted">
			<bootloader name="grub2" grub_template="grub.cfg.iso-template" timeout="10" video_mode="1920x1080x32"/>
		</type>
	</preferences>

	<preferences profiles="Disk">
	        <type image="oem" volid="NorTKOS" filesystem="btrfs" btrfs_root_is_subvolume="true" btrfs_set_default_volume="false" installiso="true" installboot="install" firmware="efi" efipartsize="512" selinux_policy="targeted" kernelcmdline="console=tty0 console=ttyS0,115200 rhgb quiet rootflags=subvol=root">
	                <bootloader name="grub2" grub_template="grub.cfg.disk.iso-template" timeout="10" video_mode="1920x1080x32">
				<bootloadersettings>
					<configoption name="modules" value="btrfs zstd ext2 fat part_gpt part_msdos all_video png jpeg gzio mdraid09 mdraid1x raid5rec raid6rec search configfile normal echo test loadenv gettext font minicmd gfxterm gfxmenu efi_gop efi_uga"/>
					<environment>
						<env name="gfxmode" value="1920x1080,1024x768,auto"/>
						<env name="gfxpayload" value="keep"/>
					</environment>
				</bootloadersettings>
			</bootloader>
			<systemdisk name="nortk">
				<volume name="@root=root"/>
				<volume name="boot" parent="/"/>
				<volume name="home" parent="/"/>
				<volume name="srv" parent="/"/>
				<volume name="var" parent="/"/>
			</systemdisk>
			<oemconfig>
				<oem-unattended>true</oem-unattended>
				<oem-reboot>true</oem-reboot>
				<oem-resize>true</oem-resize>
				<oem-swap>true</oem-swap>
				<oem-swapsize>1024</oem-swapsize>
				<oem-multipath-scan>false</oem-multipath-scan>
			</oemconfig>
		</type>
	</preferences>

	<users>
		<user password="Los Nortekos." pwdformat="plain" home="/root" name="root" groups="root"/>
	</users>

	<repository type="rpm-md" alias="baseos" sourcetype="metalink">
		<source path="https://mirrors.centos.org/metalink?repo=centos-baseos-$releasever-stream&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-10"/>
		</source>
	</repository>

	<repository type="rpm-md" alias="appstream" sourcetype="metalink">
		<source path="https://mirrors.centos.org/metalink?repo=centos-appstream-$releasever-stream&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-10"/>
		</source>
	</repository>

	<repository type="rpm-md" alias="crb" sourcetype="metalink">
		<source path="https://mirrors.centos.org/metalink?repo=centos-crb-$releasever-stream&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-10"/>
		</source>
	</repository>

	<repository type="rpm-md" alias="epel" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=epel-10&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/epel/RPM-GPG-KEY-EPEL-10"/>
		</source>
	</repository>

	<repository type="rpm-md" alias="extras-common" sourcetype="metalink">
		<source path="https://mirrors.centos.org/metalink?repo=centos-extras-sig-extras-common-10-stream&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-SIG-Extras-SHA512"/>
		</source>
	</repository>

	<repository type="rpm-md" alias="hyperscale-packages" sourcetype="metalink" priority="1">
		<source path="https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-main-10-stream&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-SIG-HyperScale"/>
		</source>
	</repository>

	<repository type="rpm-md" alias="hyperscale-experimental" sourcetype="metalink" priority="1">
		<source path="https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-experimental-10-stream&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-SIG-HyperScale"/>
		</source>
	</repository>

	<repository type="rpm-md" alias="hyperscale-kernel" sourcetype="metalink" priority="1">
		<source path="https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-kernel-10-stream&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-SIG-HyperScale"/>
		</source>
	</repository>

	<packages type="image" patternType="plusRecommended">
		<namedCollection name="base"/>
		<namedCollection name="core"/>
		<namedCollection name="system-tools"/>

		<package name="btrfs-progs"/>
		<package name="centos-release-hyperscale"/>
		<package name="centos-release-hyperscale-experimental"/>
		<package name="centos-release-hyperscale-kernel"/>
		<package name="epel-release"/>
		<package name="gdisk"/>
		<package name="glibc-langpack-en"/>
		<package name="glibc-langpack-es"/>
		<package name="grub2-efi-x64" arch="x86_64"/>
		<package name="grub2-efi-x64-cdboot" arch="x86_64"/>
		<package name="grub2-efi-x64-modules" arch="x86_64"/>
		<package name="grub2-pc" arch="x86_64"/>
		<package name="grub2-pc-modules"/>
		<package name="grub2-tools" arch="x86_64"/>
		<package name="htop"/>
		<package name="kernel"/>
		<package name="kernel-modules"/>
		<package name="kernel-modules-core"/>
		<package name="kernel-modules-extra"/>
		<package name="plymouth-graphics-libs"/>
		<package name="plymouth-plugin-label"/>
		<package name="plymouth-plugin-script"/>
		<package name="plymouth-plugin-two-step"/>
		<package name="plymouth-scripts"/>
		<package name="plymouth-theme-script"/>
		<package name="policycoreutils"/>
		<package name="selinux-policy-targeted"/>
		<package name="shim-x64" arch="x86_64"/>
	</packages>

	<packages type="image" profiles="Live">
		<package name="dracut-kiwi-live"/>
		<package name="dracut-network"/>
		<file name="grub.cfg.iso-template"/>
	</packages>

	<packages type="image" profiles="Disk">
		<package name="dracut-kiwi-oem-dump"/>
		<package name="dracut-kiwi-oem-repart"/>
		<package name="dracut-kiwi-live"/>
		<package name="dracut-network"/>
		<file name="grub.cfg.disk.iso-template"/>
	</packages>

	<packages type="bootstrap" patternType="plusRecommended">
		<package name="basesystem"/>
		<package name="btrfs-progs"/>
		<package name="dnf"/>
		<package name="filesystem"/>
		<package name="grub2-common"/>
		<package name="grub2-efi-x64" arch="x86_64"/>
		<package name="grub2-efi-x64-modules" arch="x86_64"/>
		<package name="grub2-pc" arch="x86_64"/>
		<package name="grub2-pc-modules" arch="x86_64"/>
		<package name="shim-x64" arch="x86_64"/>
	</packages>
</image>
