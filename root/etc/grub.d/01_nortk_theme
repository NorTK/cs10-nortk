#!/usr/bin/sh
# NorTK Theme and Resolution Enforcement

echo "set gfxmode=1920x1080,1024x768,auto"
echo "set gfxpayload=keep"
echo "insmod all_video"
echo "insmod gfxterm"
echo "insmod png"
echo "insmod jpeg"
echo "insmod font"

# Re-initialize gfxterm to apply the new resolution
echo "terminal_output console"
echo "terminal_output gfxterm"

# Theme path is set in /etc/default/grub by KIWI, but we can re-assert it here
# to ensure it's loaded with the correct resolution.
echo "set theme=/boot/grub2/themes/nortk/theme.txt"
