# Inspired by the config used for official live media (c10s)

set default=0

# Use search to find the root partition on the ISO
search --file --set=root /boot/grub2/themes/nortk/theme.txt

if [ "$$grub_platform" = "efi" ]; then
    function load_video {
        insmod efi_gop
        insmod efi_uga
        insmod video_bochs
        insmod video_cirrus
        insmod all_video
    }
    set basicgfx="nomodeset"
else
    function load_video {
        insmod all_video
    }
    set basicgfx="nomodeset vga=791"
fi

insmod gzio
insmod part_gpt
insmod ext2
insmod fat
insmod png
insmod jpeg
insmod font

if loadfont ($$root)/boot/grub2/themes/nortk/terminus-18.pf2; then
    loadfont ($$root)/boot/grub2/themes/nortk/unifont-32.pf2
fi

set gfxmode=1920x1080,1024x768,auto
load_video
insmod gfxterm
terminal_input console
terminal_output gfxterm

set theme=($$root)/boot/grub2/themes/nortk/theme.txt

set timeout="${boot_timeout}"
set timeout_style="${boot_timeout_style}"

menuentry "Install NorTK OS (CentOS Stream 10)" --class fedora --class gnu-linux --class gnu --class os {
    linux ($$root)${bootpath}/${kernel_file} ${boot_options} rd.kiwi.install rd.kiwi.install.selectdisk=1
    initrd ($$root)${bootpath}/${initrd_file}
}

submenu "Troubleshooting -->" {
    menuentry "Install NorTK OS in basic graphics mode" --class fedora --class gnu-linux --class gnu --class os {
        linux ($$root)${bootpath}/${kernel_file} ${boot_options} $$basicgfx rd.kiwi.install rd.kiwi.install.selectdisk=1
        initrd ($$root)${bootpath}/${initrd_file}
    }
}
